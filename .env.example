# -----------------------------------------------------------------------
# Groq API — required for the cloud LLM fallback (Llama 3.1 8B)
# Get your key at https://console.groq.com/keys
# -----------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here

# -----------------------------------------------------------------------
# OpenAI API — optional, only used as a last-resort embedding fallback
# if both SentenceTransformers and HuggingFace direct loading fail.
# -----------------------------------------------------------------------
# OPENAI_API_KEY=sk_your_openai_key_here
